# Copy to backend/.env and fill in. This file is loaded at startup by
# app/core/config.py. Real shell environment variables take precedence, so
# anything you already export (e.g. NVIDIA_API_KEY) keeps working.
# backend/.env is gitignored — never commit real secrets.

# --- LLM / embeddings (example: NVIDIA NIM + local Ollama embeddings) ---
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_MODEL=openai/gpt-oss-20b

# --- Connector token encryption (REQUIRED for any connector) ---
# Generate once and keep stable; rotating it makes stored tokens undecryptable:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# CONNECTOR_SECRET_KEY=

# --- GitHub connector (OAuth App) ---
# From https://github.com/settings/developers → OAuth Apps → New OAuth App.
# Authorization callback URL must be exactly:
#   http://localhost:8100/api/integrations/github/oauth/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_BASE_URL=http://localhost:8100

# --- Jira connector (Atlassian 3LO OAuth) ---
# JIRA_CLIENT_ID=
# JIRA_CLIENT_SECRET=
# JIRA_REDIRECT_BASE_URL=http://localhost:8100

# --- Slack connector ---
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# SLACK_REDIRECT_BASE_URL=http://localhost:8100

# Copy to backend/.env and fill in what you need. Loaded at startup by
# app/core/config.py. Real shell environment variables take precedence, so
# anything you already export keeps working.
#
# backend/.env is gitignored — never commit real secrets.
#
# Every setting below is optional unless marked REQUIRED, and the value shown is
# the built-in default. Sections mirror app/core/config.py.

# ─── Database ────────────────────────────────────────────────────────────────
# Must be Postgres with pgvector available. Default matches docker-compose.yml.
# DATABASE_URL=postgresql://ybase:ybase@localhost:5433/ybase
# DB_POOL_MIN_SIZE=2
# DB_POOL_MAX_SIZE=20            # × instance count must stay under your PG limit
# DB_COMMAND_TIMEOUT_S=30        # per-statement ceiling; 0 disables

# ─── Browser / API security (set these in production) ────────────────────────
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SESSION_COOKIE_SECURE=false    # true behind HTTPS
# SESSION_DAYS=14
# PASSWORD_MIN_LENGTH=12
# MAX_REQUEST_BYTES=10485760     # hard ceiling on a request body
# MAX_QUESTION_CHARS=4000
# MAX_DOCUMENT_CHARS=1000000
# MAX_MESSAGE_CHARS=100000
# Trusted real-client-IP header injected by your proxy — NOT forwardable by the
# client. "fly-client-ip" on Fly, "cf-connecting-ip" behind Cloudflare. Empty =
# use the rightmost X-Forwarded-For entry.
# REAL_IP_HEADER=

# ─── Signup, sessions, invites ───────────────────────────────────────────────
# ALLOW_PUBLIC_SIGNUP=true       # false for single-tenant self-hosted installs
# SEED_DEMO_ON_SIGNUP=true
# INVITE_TTL_DAYS=14
# LOGIN_MAX_FAILURES=5
# LOGIN_WINDOW_MINUTES=15
# PASSWORD_RESET_TTL_MINUTES=60
# VERIFICATION_TTL_HOURS=48
# Verification and password-reset links are delivered by email — with no email
# provider configured (below) they are silently discarded.

# ─── Rate limits (events per minute; 0 disables) ─────────────────────────────
# QUERY_RATE_PER_MINUTE=20
# INGEST_RATE_PER_MINUTE=120
# AUTH_RATE_PER_MINUTE=10        # per IP, on the unauthenticated auth routes
# AGENT_RATE_PER_MINUTE=60       # per API key, on /api/agent/*

# ─── Billing ─────────────────────────────────────────────────────────────────
# TRIAL_DAYS=7
# Activates the paid plan WITHOUT taking payment. Leave false on any public
# deployment — it is a free-plan giveaway. Local/self-hosted only.
# BILLING_STUB_CHECKOUT=false

# ─── LLM provider ────────────────────────────────────────────────────────────
# LLM_PROVIDER=auto              # auto | anthropic | nvidia | ollama
# ANTHROPIC_API_KEY=sk-ant-...   # required when LLM_PROVIDER=anthropic
# ANTHROPIC_MODEL=claude-fable-5
# NVIDIA_API_KEY=nvapi-...       # NVIDIA_NIM_API_KEY is accepted as an alias
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=openai/gpt-oss-120b
# NVIDIA_MAX_TOKENS=4096
# NVIDIA_TEMPERATURE=1
# NVIDIA_TOP_P=1
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3.5
# OLLAMA_NUM_CTX=16384

# ─── Embeddings ──────────────────────────────────────────────────────────────
# EMBED_PROVIDER=auto            # auto | voyage | ollama | local (hash, demo only)
# VOYAGE_API_KEY=
# OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── Retrieval tuning ────────────────────────────────────────────────────────
# TOP_K=8
# Over-fetch this many ANN candidates per final vector result, then exact-order
# that workspace/model-owned candidate set. Minimum 1.
# VECTOR_CANDIDATE_MULTIPLIER=4
# pgvector >= 0.8: continue HNSW scanning when workspace/model filters would
# otherwise under-fill top-k. Uses SET LOCAL and is safe with PgBouncer pooling.
# HNSW_ITERATIVE_SCAN=true
# CONTEXT_CHUNK_CAP=22
# CONTEXT_CHAR_BUDGET=45000
# GRAPH_HOPS=2
# GRAPH_MAX_NODES=40

# ─── Memory formation queue ──────────────────────────────────────────────────
# FORMATION_CONCURRENCY=0        # 0 = auto (1 on Ollama, 3 on Anthropic)
# FORMATION_MAX_ATTEMPTS=3
# FORMATION_BACKOFF_S=60
# FORMATION_READ_TIMEOUT_S=300
# FORMATION_TASK_TIMEOUT_S=420   # must exceed FORMATION_READ_TIMEOUT_S
# FORMATION_STALL_S=600          # must exceed FORMATION_TASK_TIMEOUT_S
# FORMATION_RUNS_RETENTION_DAYS=30
# FORMATION_DAILY_QUOTA_TRIAL=100
# FORMATION_DAILY_QUOTA_TEAM=5000
# VALIDATION_MIN_REASONING_CHARS=40

# ─── Consolidation ───────────────────────────────────────────────────────────
# MERGE_SIM_THRESHOLD=0.86
# CONSOLIDATION_DEBOUNCE_S=120
# CONSOLIDATION_MAX_DELAY_S=900
# CONSOLIDATION_TASK_TIMEOUT_S=300

# ─── Observability & ops ─────────────────────────────────────────────────────
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0
# LOG_FORMAT=text                # text | json
# Guards the detailed /api/health/formation payload (fleet-wide queue counts).
# Without it the endpoint reports liveness only.
# HEALTH_TOKEN=
# USAGE_RETENTION_DAYS=90
# COST_RATES_JSON={"claude-fable-5":{"input_per_mtok":3.0,"output_per_mtok":15.0}}

# ─── Multi-instance coordination (Redis) ─────────────────────────────────────
# Only needed when running more than one instance. Redis MUST run with
# maxmemory-policy=noeviction — an evicted workspace lock would let two
# instances form the same workspace concurrently.
# REDIS_URL=
# REDIS_KEY_PREFIX=ybase
# FORMATION_LOCK_TTL_S=0         # 0 = auto (FORMATION_TASK_TIMEOUT_S + 60)
# WORKER_INSTANCE_ID=            # defaults to FLY_ALLOC_ID or a random id
# LEADER_TTL_S=60

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Without both of these, password-reset, verification, and digest emails are
# logged no-ops. Configure before enabling public signup.
# RESEND_API_KEY=
# DIGEST_FROM_EMAIL=
# Base URL used in emailed links (verification, reset, invites, digests).
# APP_BASE_URL=http://localhost:5173

# ─── Digests ─────────────────────────────────────────────────────────────────
# DIGEST_ENABLED=true
# DIGEST_INTERVAL_S=604800       # weekly
# STALE_QUESTION_DAYS=21

# ─── Connector sync scheduling ───────────────────────────────────────────────
# CONNECTOR_RESYNC_INTERVAL_S=21600
# CONNECTOR_RESYNC_WINDOW_DAYS=2
# CONNECTOR_BACKFILL_DAYS=90
# FAST_SLICE_DAYS=7              # first backfill slice, so memory forms in minutes
# SYNC_JOB_STALE_S=1800

# ─── Connector token encryption (REQUIRED for any connector) ─────────────────
# Generate once and keep stable; losing it makes stored tokens undecryptable:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# CONNECTOR_SECRET_KEY=
# During a rotation, put the previous key here, run
# scripts/rotate_connector_key.py, then clear it.
# CONNECTOR_SECRET_KEYS_OLD=

# ─── Google sign-in (OAuth 2.0 / OIDC) ───────────────────────────────────────
# Redirect URI: <GOOGLE_REDIRECT_BASE_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_BASE_URL=http://localhost:8100

# ─── Connector: Slack ────────────────────────────────────────────────────────
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=          # empty disables the inbound Events endpoint
# SLACK_REDIRECT_BASE_URL=http://localhost:8100
# SLACK_THREAD_QUIET_S=600
# SLACK_MIN_THREAD_CHARS=200
# SLACK_EVENTS_RATE_PER_MINUTE=600
# SLACK_RECONCILE_INTERVAL_S=3600
# SLACK_RECONCILE_WINDOW_DAYS=1

# ─── Connector: Jira (Atlassian 3LO) ─────────────────────────────────────────
# Scopes: read:jira-work, read:jira-user, offline_access
# JIRA_CLIENT_ID=
# JIRA_CLIENT_SECRET=
# JIRA_REDIRECT_BASE_URL=http://localhost:8100
# JIRA_MAX_ISSUES_PER_PROJECT=500

# ─── Connector: GitHub (OAuth App) ───────────────────────────────────────────
# Callback: <base>/api/integrations/github/oauth/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_BASE_URL=http://localhost:8100
# GITHUB_MAX_ITEMS_PER_REPO=300

# ─── Connector: Linear ───────────────────────────────────────────────────────
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=
# LINEAR_REDIRECT_BASE_URL=http://localhost:8100
# LINEAR_MAX_ISSUES_PER_TEAM=500

# ─── Connector: Confluence (separate Atlassian app from Jira's) ──────────────
# Scopes: read:page:confluence, read:space:confluence, offline_access
# CONFLUENCE_CLIENT_ID=
# CONFLUENCE_CLIENT_SECRET=
# CONFLUENCE_REDIRECT_BASE_URL=http://localhost:8100
# CONFLUENCE_MAX_PAGES_PER_SPACE=300

# ─── Connector: Discord ──────────────────────────────────────────────────────
# Requires the Message Content privileged intent on the bot.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_BOT_TOKEN=
# DISCORD_REDIRECT_BASE_URL=http://localhost:8100
# DISCORD_MAX_MESSAGES_PER_CHANNEL=2000
# DISCORD_MIN_DIGEST_CHARS=400

# ─── Connector: Google Docs (separate OAuth client from sign-in) ─────────────
# GOOGLE_DOCS_CLIENT_ID=
# GOOGLE_DOCS_CLIENT_SECRET=
# GOOGLE_DOCS_REDIRECT_BASE_URL=http://localhost:8100
# GOOGLE_DOCS_MAX_DOCS=300

# ─── Connector: Notion ───────────────────────────────────────────────────────
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# NOTION_REDIRECT_BASE_URL=http://localhost:8100
# NOTION_MAX_PAGES_PER_STREAM=200
# NOTION_MAX_BLOCKS_PER_PAGE=500

# ─── Connector: Figma ────────────────────────────────────────────────────────
# Scope: files:read. The team id must be pasted from the Figma URL after
# connecting — there is no API to list a user's teams.
# FIGMA_CLIENT_ID=
# FIGMA_CLIENT_SECRET=
# FIGMA_REDIRECT_BASE_URL=http://localhost:8100
# FIGMA_MAX_FILES_PER_PROJECT=50

# ─── Serving the built frontend (set in the Docker image) ────────────────────
# STATIC_DIR=
